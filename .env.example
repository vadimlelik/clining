# Публичный URL сайта (для OG, canonical, sitemap, schema)
NEXT_PUBLIC_SITE_URL=https://www.chistkaminsk.ru

# IndexNow: ключ 8–128 hex-символов (openssl rand -hex 16). Файл ключа: https://ваш-домен/<ключ>.txt
INDEXNOW_KEY=

# Контакты на сайте и в schema (замените телефон на рабочий)
# NEXT_PUBLIC_CONTACT_PHONE=+375 (29) 123-45-67
# NEXT_PUBLIC_CONTACT_EMAIL=info@chistkaminsk.ru

# Админ: один пароль и секрет для JWT-куки (минимум 16 символов)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Заявки (опционально)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# CRM_WEBHOOK_URL=

# Хранилище фото «до/после» на Vercel (продакшен). Без токена — локально в public/uploads/before-after
# BLOB_READ_WRITE_TOKEN=
